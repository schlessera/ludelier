{
  "name": "ludelier",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx packages/cli/src/index.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=main",
    "version": "changeset version && pnpm install --no-frozen-lockfile",
    "release": "pnpm -r publish --access public --no-git-checks",
    "dev:web": "pnpm --filter @ludelier/runtime-web dev",
    "dev:editor": "pnpm --filter @ludelier/editor-web dev",
    "build:web": "pnpm --filter @ludelier/runtime-web build",
    "build:editor": "pnpm --filter @ludelier/editor-web build",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
