{
  "meta": { "id": "cafe", "title": "Café Encounter", "start": "start", "seed": 42 },
  "characters": [
    { "id": "narrator", "name": "Narrator" },
    { "id": "mc", "name": "You", "color": "#6ab0ff" },
    { "id": "her", "name": "Her", "color": "#ff9ec3" },
    { "id": "rin", "name": "Rin", "color": "#5fae7a" }
  ],
  "assets": [
    { "id": "bg_cafe", "src": "/assets/cafe/bg.webp" },
    { "id": "bg_street", "src": "/assets/cafe/bg_street.webp" },
    { "id": "her", "src": "/assets/cafe/her.webp" },
    { "id": "rin", "src": "/assets/cafe/rin.webp" }
  ],
  "nodes": [
    {
      "id": "start",
      "body": [
        { "op": "scene", "bg": "bg_cafe" },
        { "op": "show", "sprite": "her", "asset": "her", "at": "center" },
        { "op": "say", "who": "narrator", "text": "A quiet café. She looks up as you enter." },
        { "op": "set", "var": "trust", "value": 0 },
        {
          "op": "choice",
          "prompt": "What do you do?",
          "options": [
            { "label": "Sit down at her table", "goto": "sit" },
            { "label": "Leave", "goto": "leave" }
          ]
        }
      ]
    },
    {
      "id": "sit",
      "body": [
        { "op": "show", "sprite": "her", "asset": "her", "at": "left" },
        { "op": "say", "who": "mc", "text": "Mind if I join you?" },
        { "op": "add", "var": "trust", "amount": 1 },
        { "op": "roll", "var": "luck", "min": 1, "max": 6 },
        {
          "op": "choice",
          "prompt": "The conversation could go either way.",
          "options": [
            {
              "label": "Stay and talk",
              "goto": "ending_good",
              "if": { "var": "trust", "cmp": "gte", "value": 1 }
            },
            { "label": "Ask about her day", "goto": "talk" },
            { "label": "Make an excuse and leave", "goto": "leave" }
          ]
        }
      ]
    },
    {
      "id": "talk",
      "body": [
        { "op": "show", "sprite": "her", "asset": "her", "at": "left" },
        { "op": "show", "sprite": "rin", "asset": "rin", "at": "right" },
        {
          "op": "say",
          "who": "rin",
          "text": "Two cups of the house blend — on me. You two look like you needed a minute."
        },
        {
          "op": "say",
          "who": "her",
          "text": "Thanks, Rin. It's been a strange day. You're the first person who's actually sat down."
        },
        { "op": "add", "var": "trust", "amount": 1 },
        { "op": "say", "who": "mc", "text": "Then I'm glad I did." },
        { "op": "hide", "sprite": "rin" },
        { "op": "branch", "cond": { "var": "luck", "cmp": "gte", "value": 4 }, "goto": "ending_lucky" },
        {
          "op": "say",
          "who": "narrator",
          "text": "You trade easy conversation until the afternoon light goes gold."
        },
        { "op": "jump", "goto": "ending_good" }
      ]
    },
    {
      "id": "leave",
      "body": [
        { "op": "hide", "sprite": "her" },
        { "op": "branch", "cond": { "var": "trust", "cmp": "gte", "value": 1 }, "goto": "leave_regret" },
        { "op": "say", "who": "mc", "text": "Maybe another time." },
        { "op": "jump", "goto": "ending_meh" }
      ]
    },
    {
      "id": "leave_regret",
      "body": [
        {
          "op": "say",
          "who": "mc",
          "text": "You catch yourself at the door. You almost turn back — almost."
        },
        { "op": "jump", "goto": "ending_meh" }
      ]
    },
    {
      "id": "ending_good",
      "body": [
        { "op": "say", "who": "narrator", "text": "You talk for hours. The coffee goes cold, happily." },
        { "op": "end" }
      ]
    },
    {
      "id": "ending_lucky",
      "body": [
        { "op": "scene", "bg": "bg_street" },
        { "op": "show", "sprite": "her", "asset": "her", "at": "center" },
        { "op": "say", "who": "her", "text": "Walk me out? Same time tomorrow?" },
        {
          "op": "say",
          "who": "narrator",
          "text": "The streetlights come on as you step outside together. Some afternoons rewrite the whole week. This was one."
        },
        { "op": "end" }
      ]
    },
    {
      "id": "ending_meh",
      "body": [
        { "op": "scene", "bg": "bg_street" },
        {
          "op": "say",
          "who": "narrator",
          "text": "The door closes behind you. The evening street is quiet, and the café forgets you."
        },
        { "op": "end" }
      ]
    }
  ]
}
